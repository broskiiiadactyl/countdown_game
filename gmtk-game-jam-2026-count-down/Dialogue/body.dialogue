#  [if SomeGlobal.some_property == true /] ,- check for variables
# use % to create a random percentage they say something
# ~ to make a cue, => to jump to a cue

~ start
while CharacterGlobals.victim.has_met == false:
	[color=sky_blue]This is the Count of the Manor.[/color]
	[color=sky_blue]You have seen many bodies in your days.[/color]
	[color=sky_blue]It never gets easier.[/color]
	set CharacterGlobals.victim.has_met = true
~ nuetral
% [color=sky_blue]You wonder what kind of person this used to be.[/color]
% [color=sky_blue]It lies still, ready to answer.[/color]
% [color=sky_blue]You find comfort in it's truth.[/color]
- What do you remember?
	if CharacterGlobals.victim.murder_weapon == "Hefty Knife":
		The Count: [color=crimson]A flash of steel.[/color]
		do Globals.blocks.append("The Count remembers 'A flash of steel'.")
	if CharacterGlobals.victim.murder_weapon == "Ripped Nets":
		The Count: [color=crimson]Too many threads.[/color]
		do Globals.blocks.append("The Count remembers 'Too many threads'.")
	if CharacterGlobals.victim.murder_weapon == "Gallon Bag":
		The Count: [color=crimson]Black all around.[/color]
		do Globals.blocks.append("The Count remembers 'Black all around'.")
		$> Globals.update_blocks.emit()
	if CharacterGlobals.victim.murder_weapon == "Rubber Gloves":
		The Count: [color=crimson]The hands were wrong.[/color]
		do Globals.blocks.append("The Count remembers 'The hands were wrong'.")
	if CharacterGlobals.victim.murder_weapon == "Nightshade":
		The Count: [color=crimson]A shade of green.[/color]
		do Globals.blocks.append("The Count remembers 'A shade of green'.")
	if CharacterGlobals.victim.murder_weapon == "Large Scissors":
		The Count: [color=crimson]Safe no longer.[/color]
		do Globals.blocks.append("The Count remembers 'Safe no longer'.")
	do Globals.count_down(1, "body_remember")
	$> Globals.update_blocks.emit()
	=> nuetral
- What should I do?
	[color=sky_blue]As always, the body does not tell you how to do your job.[/color]
	=> nuetral
- When did you die?
	[color=sky_blue]A shiver runs through you.[/color]
	if CharacterGlobals.victim.time_of_death == "morning":
		The Count: [color=crimson]As I began to wander the world.[/color][br]My expectations unmet and my flowers unwatered.
		do Globals.blocks.append("The Count died 'As I began to wander the world'.")
	if CharacterGlobals.victim.time_of_death == "noon":
		The Count: [color=crimson]At the peak of my life.[/color][br]With the sun above my head and ground below my feet.
		do Globals.blocks.append("The Count died 'At the peak'.")
	if CharacterGlobals.victim.time_of_death == "night":
		The Count: [color=crimson]As the dust settled down.[/color][br]My demons left to rest and my ambitions realized.
	do Globals.blocks.append("The Count died 'As the dust settled down'.")
	do Globals.count_down(1, "body_die")
	$> Globals.update_blocks.emit()
- I know who killed you.
	[color=crimson][shake]Are you certain?[/shake][br]Once you make an accusation, there is no going back.[/color]
	- Yes
		[color=crimson][shake]Then name the murderer.[/shake][br]
		- Clay
			do Globals.game_end("Clay")
		- Cookie
			do Globals.game_end("Cookie")
		- Mike
			do Globals.game_end("Mike")
		- Jerry
			do Globals.game_end("Jerry")
	- No
		=> nuetral
- (Leave)
	=> END
=> nuetral