#  [if SomeGlobal.some_property == true /] ,- check for variables
# use % to create a random percentage they say something
# ~ to make a cue, => to jump to a cue

~ start
while CharacterGlobals.characters["Clay"].has_met == false:
	Svelte Feline Individual: Howdy.
	Clay: Name's Clay.[br]'Fore you ask, Yes.
	Clay: I am a cowboy catboy.
	Clay: Now that that's out the way, you the detective they called for?... You a little tender aintcha?
	Clay: Well, whatever floats your  fancy. Betcha have silly questions t'ask.
	set CharacterGlobals.characters["Clay"].has_met = true
~ nuetral
% Clay: Hop to it, son. I ain't got all day.
% Clay: Somethin' you need?
% Clay: Don't touch the ears or the hat.
- Who do you think did it?
	Clay:  Well... Can't say I rightly know.[br]Don't judge 'em till I know 'em.[br]And I ain't ever known no murderer.
	=> nuetral
- Tell me about yourself.
	Clay: Not much to say. I like nappin', steerin', and rearin'.
	Clay: Count called me here and I obliged.[br]Not sure why.
	Clay: Point is, I didn't kill 'em. And that's that.
	=> nuetral
- Do you recognize this item?
	=> items
- What were you doing today?
	match CharacterGlobals.characters["Clay"].activity:
		when "Fishing"
			Clay: Welp, spent the day untanglin' bird's nests.
			Clay: Long ride down a cold trail.
			Clay: Losin' worms in water.
			Clay: [color=crimson]Fishin[/color]... I was [color=crimson]fishin[/color].
		when "Cooking"
			Clay: [color=crimson]Cooking[/color].
			Clay: Only thing I love more than trailin' is eatin' and you gotta cook to eat.
		when "Gardening"
			Clay: Spent a good chunk of time [color=crimson]gardening[/color].
			Clay: Nice to see some green before headin' out on those plains.
		when "Dressing up"
			Clay: I ain't ashamed to admit I spent the day [color=crimson]dressin' up[/color].
			Clay: You think these hats and spurs buy themselves?[br]Takes a real man to know the good from the bad.
			Clay: That requires putten' 'em on. You wouldn't get it.
		when ""
			Clay: Looks like initialization didn't assign me anything.
			Clay: So nothing, apparently. [rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Honk Honk![/rainbow]
	do Globals.blocks.append("Clay spent the day "+CharacterGlobals.characters["Clay"].activity)
	$> Globals.update_blocks.emit()
	=> nuetral
- Where were you...
	=> timesegments
- Count down once.
	Clay: I'm counting down.
	do Globals.count_down(1, "count_down_once")
	=> nuetral
- That's all. (Leave)
	=> END

~ timesegments
- Morning
	Clay: Welp. Started my ride today in the [color=crimson]{{CharacterGlobals.characters["Clay"].morning}}[/color].
	do Globals.blocks.append("Clay was in the "+CharacterGlobals.characters["Clay"].morning+" in the Morning.")
	$> Globals.update_blocks.emit()
	do Globals.count_down(1, "clay_morning")
	=> nuetral
- Afternoon
	Clay: Middle of the day? If I recall I was in the [color=crimson]{{CharacterGlobals.characters["Clay"].noon}}[/color].
	do Globals.blocks.append("Clay was in the "+CharacterGlobals.characters["Clay"].noon+" in the Aftenoon.")
	$> Globals.update_blocks.emit()
	do Globals.count_down(1, "clay_noon")
	=> nuetral
- Evening
	Clay: Spent the evenin' round the [color=crimson]{{CharacterGlobals.characters["Clay"].morning}}[/color].
	do Globals.blocks.append("Clay was in the "+CharacterGlobals.characters["Clay"].night+" in the Evening.")
	$> Globals.update_blocks.emit()
	do Globals.count_down(1, "clay_night")
	=> nuetral
- Nevermind
	=> nuetral

~ items
#check the size of the inventory array and use a match case
#did you know toby fox used one giant match case for the entirety of the homsetuck dialogue wow
match Globals.inventory.size()
	when 0
		You don't have anything. Maybe there are things to find in the Manor...?
		- Go back
			=> nuetral

	when 1
		- {{Globals.item1}}
			=> checkitem1
		- No Item [if Globals.item1==""]
		- No Item [if Globals.item1==""]
		- No Item [if Globals.item1==""]
		- Go back
			=> nuetral

	when 2
		- {{Globals.item1}}
			=> checkitem1
		- {{Globals.item2}}
			=> checkitem2
		- No Item [if Globals.item1==""]
		- No Item [if Globals.item1==""]
		- Go back
			=> nuetral

	when 3
		- {{Globals.item1}}
			=> checkitem1
		- {{Globals.item2}}
			=> checkitem2
		- {{Globals.item3}}
			=> checkitem3
		- No Item [if Globals.item1==""]
		- Go back
			=> nuetral

	when 4
		- {{Globals.item1}}
			=> checkitem1
		- {{Globals.item2}}
			=> checkitem2
		- {{Globals.item3}}
			=> checkitem3
		- {{Globals.item4}}
			=> checkitem4
		- Go back
			=> nuetral

=> nuetral

~ checkitem1
if Globals.item1 == CharacterGlobals.characters["Clay"].item:
	Clay: Yup, I reckon that's mine. How did I lose it 'gain...
	do Globals.blocks.append("The "+Globals.item1+" belongs to Clay.")
	$> Globals.update_blocks.emit()
else
	Clay: Nope. Never seen it' fore.
=> nuetral

~ checkitem2
if Globals.item2 == CharacterGlobals.characters["Clay"].item:
	Clay: Yup, I reckon that's mine. How did I lose it 'gain...
	do Globals.blocks.append("The "+Globals.item2+" belongs to Clay.")
	$> Globals.update_blocks.emit()
else
	Clay: Nope. Never seen it' fore.
=> nuetral

~ checkitem3
if Globals.item3 == CharacterGlobals.characters["Clay"].item:
	Clay: Yup, I reckon that's mine. How did I lose it 'gain...
	do Globals.blocks.append("The "+Globals.item3+" belongs to Clay.")
	$> Globals.update_blocks.emit()
else
	Clay: Nope. Never seen it' fore.
=> nuetral

~ checkitem4
if Globals.item4 == CharacterGlobals.characters["Clay"].item:
	Clay: Yup, I reckon that's mine. How did I lose it 'gain...
	do Globals.blocks.append("The "+Globals.item4+" belongs to Clay.")
	$> Globals.update_blocks.emit()
else
	Clay: Nope. Never seen it' fore.
=> nuetral