#  [if SomeGlobal.some_property == true /] ,- check for variables
# use % to create a random percentage they say something
# ~ to make a cue, => to jump to a cue

~ start
while CharacterGlobals.characters["Jerry"].has_met == false:
	Jerry: Evening. My name is Gerard but you may call me Jerry.
	Jerry: I served at the pleasure of his Count.
	Jerry: I'm very eager for this matter to be over so I can take a nap for the first time in twenty years.
	set CharacterGlobals.characters["Jerry"].has_met = true
~ nuetral
% Jerry: Sorry I kind of spaced out there for a minute.
% Jerry: I live to serve.
% Jerry: *sigh* How can I help?
- Who do you think did it?
	Jerry: If I say it was me do I get to go home sooner?
	=> nuetral
- Tell me about yourself.
	Jerry: I am now realizing that the Count's passing has made me unemployed.
	Jerry: I have never feel so relieved while being so panicked in my life.
	=> nuetral
- Do you recognize this item?
	=> items
- What were you doing today?
	match CharacterGlobals.characters["Jerry"].activity:
		when "Fishing"
			Jerry: *sigh* The Count wanted fresh fish.
			Jerry:  Store bought wasn't nearly good enough for our dearest Count, so I was forced to cultivate the habit of [color=crimson]fishing[/color].
		when "Cooking"
			Jerry: The Count's schedule necessitates an incredible need for meal prepping in order to secure gains and as such I was [color=crimson]Cooking[/color].
		when "Gardening"
			Jerry: [color=crimson]Gardening[/color]. Someone has to maintain the pristine edge of this manor both within and without.
		when "Dressing up"
			 Jerry: Well if you must know, I spent the day [color=crimson]dressing up[/color]. A man simply must have hobbies.
		when ""
			Jerry: Looks like initialization didn't assign me anything.
			Jerry: So nothing, apparently. [rainbow freq=1.0 sat=0.8 val=0.8 speed=1.0]Honk Honk![/rainbow]
	=> nuetral
- Where were you...
	=> timesegments
- Count down once.
	Jerry: I'm counting down.
	do Globals.count_down(1, "count_down_once")
	=> nuetral
- That's all. (Leave)
	=> END

~ timesegments
- Morning
	Jerry: As Usual. Languishing in the [color=crimson]{{CharacterGlobals.characters["Jerry"].morning}}[/color].
	do Globals.count_down(1, "Jerry_morning")
	=> nuetral
- Afternoon
	Jerry: To be frank, hiding. The Count spends very little time in the [color=crimson]{{CharacterGlobals.characters["Jerry"].noon}}[/color] so I try to frequent it when possible.
	do Globals.count_down(1, "Jerry_noon")
	=> nuetral
- Evening
	Jerry: Around the [color=crimson]{{CharacterGlobals.characters["Jerry"].night}}[/color]. I will not lie, I sort of entered a fugue state and wandered into there.
	do Globals.count_down(1, "Jerry_night")
	=> nuetral
- Nevermind
	=> nuetral

~ items
#check the size of the inventory array and use a match case
#did you know toby fox used one giant match case for the entirety of the homsetuck dialogue wow
match Globals.inventory.size()
	when 0
		You don't have anything. Maybe there are things to find in the Manor...?
		- Go back
			=> nuetral

	when 1
		- {{Globals.item1}}
			=> checkitem1
		- No Item [if Globals.item1==""]
		- No Item [if Globals.item1==""]
		- No Item [if Globals.item1==""]
		- Go back
			=> nuetral

	when 2
		- {{Globals.item1}}
			=> checkitem1
		- {{Globals.item2}}
			=> checkitem2
		- No Item [if Globals.item1==""]
		- No Item [if Globals.item1==""]
		- Go back
			=> nuetral

	when 3
		- {{Globals.item1}}
			=> checkitem1
		- {{Globals.item2}}
			=> checkitem2
		- {{Globals.item3}}
			=> checkitem3
		- No Item [if Globals.item1==""]
		- Go back
			=> nuetral

	when 4
		- {{Globals.item1}}
			=> checkitem1
		- {{Globals.item2}}
			=> checkitem2
		- {{Globals.item3}}
			=> checkitem3
		- {{Globals.item4}}
			=> checkitem4
		- Go back
			=> nuetral

=> nuetral

~ checkitem1
if Globals.item1 == CharacterGlobals.characters["Jerry"].item:
	Jerry: Why, yes. It is. Thank you for finding it.
	do Globals.blocks.append("The "+Globals.item1+" belongs to Jerry.")
	$> Globals.update_blocks.emit()
else
	Jerry: Whomp Whomp. Huge loser moment! Not even close!
=> nuetral

~ checkitem2
if Globals.item2 == CharacterGlobals.characters["Jerry"].item:
	Jerry: Why, yes. It is. Thank you for finding it.
	do Globals.blocks.append("The "+Globals.item2+" belongs to Jerry.")
	$> Globals.update_blocks.emit()
else
	Jerry: Unfortunately, no. You will have to continue your journey elsewhere.
=> nuetral

~ checkitem3
if Globals.item3 == CharacterGlobals.characters["Jerry"].item:
	Jerry: Why, yes. It is. Thank you for finding it.
	do Globals.blocks.append("The "+Globals.item3+" belongs to Jerry.")
	$> Globals.update_blocks.emit()
else
	Jerry: Unfortunately, no. You will have to continue your journey elsewhere.
=> nuetral

~ checkitem4
if Globals.item4 == CharacterGlobals.characters["Jerry"].item:
	Jerry: Oh my god, [wave amp=50.0 freq=5.0 connected=1]YES[/wave]! I've been looking for it everywhere. Thaaaaaaaanks~
	do Globals.blocks.append("The "+Globals.item4+" belongs to Jerry.")
	$> Globals.update_blocks.emit()
else
	Jerry: Unfortunately, no. You will have to continue your journey elsewhere.
=> nuetral